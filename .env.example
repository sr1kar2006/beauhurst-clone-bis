# TODO(Faisal): confirm deployment URL. Nothing in the app hardcodes a domain.

# Public origin (and path) the demo is served from. Used for share links, Open Graph tags
# and "View online" links inside exported files. Leave empty to use the current browser origin.
VITE_PUBLIC_BASE_URL=

# Sub-path the app is served under, e.g. /cma-demo/ . Default: /
VITE_BASE_PATH=/
